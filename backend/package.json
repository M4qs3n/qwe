{
  "name": "cyberbracket-backend-js",
  "version": "1.0.0",
  "description": "Pure JS Backend for CyberBracket System",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/cyberbracket-backend-chat.exe && node -e \"const fs=require('fs');fs.cpSync('../frontend','dist/frontend',{recursive:true});\""
  },
  "pkg": {
    "assets": [
      "database.db",
      "schema.sql",
      "node_modules/sqlite3/build/Release/node_sqlite3.node"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "express",
    "postgresql",
    "jwt",
    "tournaments",
    "cyberbracket"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pkg": "^5.8.1"
  }
}
